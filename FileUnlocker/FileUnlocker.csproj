<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>key.ico</ApplicationIcon>
    <RootNamespace>FileUnlocker</RootNamespace>
    <AssemblyName>FileUnlocker</AssemblyName>
    <Product>File Unlocker</Product>
    <Company>Marian Pekár</Company>
    <Authors>Marian Pekár</Authors>
    <Copyright>Copyright (c) Marian Pekár</Copyright>
    <Description>Closes the processes that lock a file or a folder so the item can be moved, renamed or deleted.</Description>
    <Version>1.2.0</Version>
    <PackageProjectUrl>https://github.com/marianpekar/file-unlocker-for-windows/releases</PackageProjectUrl>
    <RepositoryUrl>https://github.com/marianpekar/file-unlocker-for-windows</RepositoryUrl>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Update="key.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="install.bat" CopyToOutputDirectory="PreserveNewest" />
    <None Update="remove.bat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
